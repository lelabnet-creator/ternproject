# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.turbo/
*.tsbuildinfo
target/

# Secrets — never commit
.env
.env.*
!.env.example
*.credentials
*.pem
*.key
agent.toml
!agent.example.toml

# Local tooling state
.dual-graph/
CONTEXT.md.bak
coverage/
playwright-report/
test-results/

# Editors / OS
.DS_Store
# Windows writes this alongside a downloaded file to record where it came from.
# The colon makes the name illegal on Windows itself, so one committed here
# fails `git checkout` on a Windows runner before a build even starts.
*:Zone.Identifier
.idea/
.vscode/*
!.vscode/extensions.json

# Rust
clients/agent/target/

# The prebuilt binaries are committed on purpose (see clients/agent/bin/README).
!clients/agent/bin/

# The local agent's working directory: agent.toml holds a live ingest key.
.tern/

# Le banc de recette : les scripts sont versionnés — sans eux la trace de
# deploy-tests/ n'est qu'une affirmation que personne ne peut rejouer — mais
# rien de ce qui se mesure en gigaoctets ou de ce qui ouvre un accès ne l'est.
.vm-lab/*/
.vm-lab/id_lab
.vm-lab/id_lab.pub

# Artefacts de construction de l'installateur hors du dépôt (CARGO_HOME local,
# cible musl construite en conteneur pour les essais).
clients/installer/.cargo-docker/
clients/installer/target-musl/

# L'état de session que la suite E2E sauvegarde pour ses tests. Il porte un
# cookie d'authentification — jetable, mais un secret n'entre pas dans
# l'historique, et il est réécrit à chaque exécution de toute façon.
e2e/.auth/
