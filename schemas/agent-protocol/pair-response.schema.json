{
  "$id": "https://tern.dev/schemas/agent-protocol/pair-response.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "apiKey": {
      "type": "string"
    },
    "agentId": {
      "type": "string"
    },
    "agentName": {
      "type": "string"
    },
    "tenantSlug": {
      "type": "string"
    },
    "jobs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "controlKey": {
            "type": "string"
          },
          "intervalS": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "probe": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "assertions": {
            "type": "array",
            "items": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          },
          "payloadShape": {
            "type": "string",
            "enum": [
              "status",
              "value"
            ]
          }
        },
        "required": [
          "controlKey",
          "intervalS",
          "probe",
          "assertions",
          "payloadShape"
        ]
      }
    }
  },
  "required": [
    "apiKey",
    "agentId",
    "agentName",
    "tenantSlug",
    "jobs"
  ]
}
