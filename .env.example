# Copy to .env — never commit the result (.gitignore blocks .env*).
#
# This is the template for running TERN *from source*. To install an instance,
# `./scripts/setup.sh` asks the questions and writes a .env itself — the
# variables it adds on top of these are listed at the bottom of this file.

# ── Database ────────────────────────────────────────────────────────────────
# Port 5433 — see docker-compose.yml: the default 5432 is left to whatever
# PostgreSQL the machine already runs.
DATABASE_URL=postgres://tern:tern@127.0.0.1:5433/tern

# ── Application secrets ─────────────────────────────────────────────────────
# APP_SECRET encrypts TOTP secrets, probe auth headers and subscriber addresses
# at rest. Rotating it makes existing encrypted values unreadable, so generate
# it once per deployment and keep it: `openssl rand -hex 32`
APP_SECRET=change-me-openssl-rand-hex-32

# ── API ─────────────────────────────────────────────────────────────────────
API_PORT=3011
API_HOST=0.0.0.0
# Public origin of the web app, used for cookies, QR pairing URLs and the
# base URL baked into generated scripts.
PUBLIC_BASE_URL=http://localhost:5173
# Comma-separated proxy CIDRs trusted for X-Forwarded-For. Leave empty when the
# API is exposed directly — trusting a header nobody sets is how rate limits
# get bypassed.
TRUSTED_PROXIES=

# ── The instance's own agent ────────────────────────────────────────────────
# TERN provisions one agent for itself, named Agent-local-tern: a row in the
# fleet, a key, and an agent.toml — written as soon as a page exists. It cannot
# be revoked or deleted from the admin; this variable is how you turn it off.
# Off, the server still probes through its in-process job.
TERN_LOCAL_AGENT=true
# Where that agent's agent.toml and offline queue live. A relative path is
# resolved from the repository root. The production image mounts /var/lib/tern,
# which is the default when NODE_ENV=production.
TERN_DATA_DIR=.tern
# The address written into agent.toml. Empty means the API on this loopback,
# which is right for both shipped deployments — from source the agent is on the
# same machine, and in the production stack its container shares the API's
# network namespace. Set it only for an agent on another host, where it has to
# be https:// anyway: the agent refuses to carry an ingest key over plain HTTP
# to anything but localhost.
TERN_LOCAL_AGENT_SERVER=
# Whether this process starts the agent binary itself. On from source, where
# there is no container to do it; docker-compose.prod.yml turns it off because
# its `agent` service runs the binary and Docker supervises it.
TERN_LOCAL_AGENT_SUPERVISE=true

# ── Mail (notifications) ────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM="TERN Status <status@example.com>"

# ── Updates ─────────────────────────────────────────────────────────────────
# Whether the admin tells you when a newer image has been published. The check
# is an anonymous tag listing against the registry below — the same request a
# `docker pull` makes, carrying nothing about this instance. Set it to false on
# an installation where nothing may leave the building, and point the image at
# your own mirror or fork if that is what you deploy from.
#
# TERN_UPDATE_CHECK=true
# TERN_UPDATE_IMAGE=ghcr.io/lelabnet-creator/ternproject
# TERN_UPDATE_CHECK_INTERVAL_H=6

# ── Web ─────────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3011

# Ingest requests per minute, per API key. The Capacity screen in the admin
# computes what your fleet actually needs — a limit below the fleet's own rate
# turns a routine retry into an outage of the path that must not fail.
INGEST_RATE_LIMIT_MAX=600

# PostgreSQL connections per API instance. Each one is a backend process, so
# this must fit inside the server's max_connections alongside everything else.
DB_POOL_MAX=10

# ── Docker install only ─────────────────────────────────────────────────────
# Read by docker-compose.prod.yml and the container entrypoint; ignored when
# running from source. `./scripts/setup.sh` writes these for you.
#
# POSTGRES_PASSWORD=…            # the compose database's own password
# TERN_HTTP_PORT=8080            # host port published in front of the app
#
# The status page, created once at first boot and then left alone.
#
# TERN_TENANT_SLUG=acme          # the address: /s/acme
# TERN_TENANT_NAME=Acme Corp
# TERN_DEFAULT_LOCALE=en
# TERN_DEFAULT_TIMEZONE=UTC
#
# The administrator and the SMTP server are NOT set here. They are entered on
# the first visit to the admin, so the password never lands in a file. The pair
# below is the exception, for an instance exposed before anyone opens it:
# setting both creates the account at boot and closes the first-run window.
# Both or neither — an address with no password creates an account nobody can
# sign into.
#
# TERN_ADMIN_EMAIL=you@example.com
# TERN_ADMIN_NAME=Your Name
# TERN_ADMIN_PASSWORD=…          # 8 characters minimum
